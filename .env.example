# Copy this file to .env and supply values locally or through your deployment
# platform. Never commit the populated .env file.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
APP_URL=http://localhost:8081

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters

SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_WEBHOOK_URL=https://api.example.com/twilio/inbound

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
